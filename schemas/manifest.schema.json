{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "path": {
            "description": "Resource directory relative to the manifest root, containing resource.yaml. Must be a dedicated subdirectory.",
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\\\:\\x00]+$"
          }
        },
        "required": [
          "id",
          "path"
        ],
        "additionalProperties": false
      }
    },
    "sandbox-images": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "context": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\\\:\\x00]+$"
              },
              {
                "const": "."
              }
            ]
          },
          "dockerfile": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\\\:\\x00]+$"
          },
          "image": {
            "type": "string",
            "minLength": 1
          },
          "platforms": {
            "type": "array",
            "items": {
              "enum": [
                "linux/amd64",
                "linux/arm64"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "context",
          "dockerfile",
          "image",
          "platforms"
        ],
        "additionalProperties": false
      },
      "minProperties": 0
    }
  },
  "required": [
    "resources",
    "sandbox-images"
  ],
  "additionalProperties": false
}
